{
  "_doc": "HybridInfer conformance vectors (SPEC.md v1). BYTE-IDENTICAL across the Python and Kotlin implementations. Both test suites load this file and MUST pass every case. To change behavior, edit these vectors first, then both implementations.",
  "version": 1,
  "complexity": {
    "short_max_tokens": 128,
    "medium_max_tokens": 512,
    "cases": [
      { "text": "", "expected_tokens": 0, "expected_bin": 0 },
      { "text": "hi", "expected_tokens": 1, "expected_bin": 0 },
      { "repeat": "word ", "times": 100, "expected_tokens": 125, "expected_bin": 0 },
      { "repeat": "word ", "times": 110, "expected_tokens": 138, "expected_bin": 1 },
      { "repeat": "word ", "times": 500, "expected_tokens": 625, "expected_bin": 2 },
      { "repeat": "word ", "times": 4000, "expected_tokens": 5000, "expected_bin": 2 }
    ]
  },
  "risk": {
    "priors": [0.02, 0.10, 0.55],
    "prior_weight": 8.0,
    "tolerance": 1e-9,
    "cases": [
      { "bin": 0, "attempts": 0, "failures": 0, "expected_pfail": 0.02 },
      { "bin": 1, "attempts": 0, "failures": 0, "expected_pfail": 0.10 },
      { "bin": 2, "attempts": 0, "failures": 0, "expected_pfail": 0.55 },
      { "bin": 2, "attempts": 20, "failures": 0, "expected_pfail": 0.15714285714285714 },
      { "bin": 2, "attempts": 10, "failures": 10, "expected_pfail": 0.8 },
      { "bin": 1, "attempts": 10, "failures": 5, "expected_pfail": 0.32222222222222224 }
    ]
  },
  "state": {
    "params": { "caution_pfail": 0.5, "unsafe_failures": 2, "recovery_cooldown_s": 60, "recovery_backoff": 2.0, "recovery_cooldown_max_s": 600 },
    "cases": [
      {
        "name": "failure_to_unsafe_then_probe_restore",
        "steps": [
          { "op": "on_local_failure", "expect_state": "CAUTION" },
          { "op": "on_local_failure", "expect_state": "UNSAFE" },
          { "op": "local_allowed", "now": 0, "expect": false, "expect_state": "UNSAFE" },
          { "op": "local_allowed", "now": 61, "expect": true, "expect_state": "RECOVERING" },
          { "op": "on_local_success", "expect_state": "RESTORED" },
          { "op": "on_local_success", "expect_state": "LOCAL_ELIGIBLE" }
        ]
      },
      {
        "name": "probe_fails_recooldown_backoff",
        "steps": [
          { "op": "on_local_failure", "expect_state": "CAUTION" },
          { "op": "on_local_failure", "expect_state": "UNSAFE" },
          { "op": "local_allowed", "now": 61, "expect": true, "expect_state": "RECOVERING" },
          { "op": "on_local_failure", "expect_state": "UNSAFE" },
          { "op": "local_allowed", "now": 100, "expect": false, "expect_state": "UNSAFE" },
          { "op": "local_allowed", "now": 122, "expect": false, "expect_state": "UNSAFE" },
          { "op": "local_allowed", "now": 182, "expect": true, "expect_state": "RECOVERING" }
        ]
      },
      {
        "name": "backoff_escalates_60_120_240",
        "steps": [
          { "op": "on_local_failure", "expect_state": "CAUTION" },
          { "op": "on_local_failure", "expect_state": "UNSAFE" },
          { "op": "local_allowed", "now": 60, "expect": true, "expect_state": "RECOVERING" },
          { "op": "on_local_failure", "expect_state": "UNSAFE" },
          { "op": "local_allowed", "now": 179, "expect": false, "expect_state": "UNSAFE" },
          { "op": "local_allowed", "now": 180, "expect": true, "expect_state": "RECOVERING" },
          { "op": "on_local_failure", "expect_state": "UNSAFE" },
          { "op": "local_allowed", "now": 419, "expect": false, "expect_state": "UNSAFE" },
          { "op": "local_allowed", "now": 420, "expect": true, "expect_state": "RECOVERING" }
        ]
      },
      {
        "name": "on_decision_caution_then_clear",
        "steps": [
          { "op": "on_decision", "pfail": 0.6, "expect_state": "CAUTION" },
          { "op": "on_decision", "pfail": 0.6, "expect_state": "CAUTION" },
          { "op": "on_local_success", "expect_state": "LOCAL_ELIGIBLE" }
        ]
      },
      {
        "name": "low_pfail_no_caution",
        "steps": [
          { "op": "on_decision", "pfail": 0.3, "expect_state": "LOCAL_ELIGIBLE" }
        ]
      }
    ]
  },
  "prefer_local": {
    "_doc": "local backend='ollama' model='m'; remote backend='openai' model='r'. Seed risk to (attempts,failures) for (local,bin). Config fields unset take defaults (force_local=false, force_remote=false, enable_runtime_health_gating=true, risk_prefer_remote=0.6).",
    "cases": [
      { "config": { "enable_runtime_health_gating": true, "risk_prefer_remote": 0.6 }, "risk": { "bin": 2, "attempts": 0, "failures": 0 }, "bin": 2, "expected_prefer_local": true },
      { "config": { "enable_runtime_health_gating": true, "risk_prefer_remote": 0.5 }, "risk": { "bin": 2, "attempts": 0, "failures": 0 }, "bin": 2, "expected_prefer_local": false },
      { "config": { "enable_runtime_health_gating": true, "risk_prefer_remote": 0.6 }, "risk": { "bin": 2, "attempts": 10, "failures": 10 }, "bin": 2, "expected_prefer_local": false },
      { "config": { "enable_runtime_health_gating": true, "risk_prefer_remote": 0.6 }, "risk": { "bin": 0, "attempts": 0, "failures": 0 }, "bin": 0, "expected_prefer_local": true },
      { "config": { "force_remote": true }, "risk": { "bin": 2, "attempts": 0, "failures": 0 }, "bin": 2, "expected_prefer_local": false },
      { "config": { "force_local": true, "enable_runtime_health_gating": true, "risk_prefer_remote": 0.5 }, "risk": { "bin": 2, "attempts": 0, "failures": 0 }, "bin": 2, "expected_prefer_local": true },
      { "config": { "enable_runtime_health_gating": false, "risk_prefer_remote": 0.5 }, "risk": { "bin": 2, "attempts": 0, "failures": 0 }, "bin": 2, "expected_prefer_local": true }
    ]
  },
  "latency": {
    "_doc": "Adaptive stall detection (SPEC.md section 9). Build a LatencyProfile(alpha, min_samples); apply each observation in order via observe(ttft_ms, gap_ms) with gap_ms=null when <2 tokens; then query stall_timeout_s and prefill_timeout_s with `query`. backend='ollama' model='m' bin=1. EWMA: first value seeds, else new = alpha*x + (1-alpha)*old. Threshold = clamp(k * baseline_ms/1000, floor_s, ceiling_s), or default_s until count>=min_samples (or the baseline is unobserved). Compare within tolerance.",
    "tolerance": 1e-9,
    "params": { "alpha": 0.3, "min_samples": 3 },
    "query": { "default_s": 20.0, "ceiling_s": 120.0, "stall_k": 8.0, "prefill_k": 4.0, "stall_floor_s": 2.0, "prefill_floor_s": 3.0 },
    "cases": [
      { "name": "bootstrap_below_min_samples", "observations": [ { "ttft_ms": 1000, "gap_ms": 500 }, { "ttft_ms": 1000, "gap_ms": 500 } ], "expected_stall_s": 20.0, "expected_prefill_s": 20.0 },
      { "name": "adaptive_steady", "observations": [ { "ttft_ms": 1000, "gap_ms": 1000 }, { "ttft_ms": 1000, "gap_ms": 1000 }, { "ttft_ms": 1000, "gap_ms": 1000 } ], "expected_stall_s": 8.0, "expected_prefill_s": 4.0 },
      { "name": "slow_device_more_headroom", "observations": [ { "ttft_ms": 8000, "gap_ms": 5000 }, { "ttft_ms": 8000, "gap_ms": 5000 }, { "ttft_ms": 8000, "gap_ms": 5000 } ], "expected_stall_s": 40.0, "expected_prefill_s": 32.0 },
      { "name": "fast_device_floor", "observations": [ { "ttft_ms": 100, "gap_ms": 50 }, { "ttft_ms": 100, "gap_ms": 50 }, { "ttft_ms": 100, "gap_ms": 50 } ], "expected_stall_s": 2.0, "expected_prefill_s": 3.0 },
      { "name": "ceiling_caps", "observations": [ { "ttft_ms": 50000, "gap_ms": 40000 }, { "ttft_ms": 50000, "gap_ms": 40000 }, { "ttft_ms": 50000, "gap_ms": 40000 } ], "expected_stall_s": 120.0, "expected_prefill_s": 120.0 },
      { "name": "ewma_tracks_recent", "observations": [ { "ttft_ms": 1000, "gap_ms": 1000 }, { "ttft_ms": 1000, "gap_ms": 2000 }, { "ttft_ms": 1000, "gap_ms": 2000 } ], "expected_stall_s": 12.08, "expected_prefill_s": 4.0 },
      { "name": "gap_null_stall_default_prefill_adapts", "observations": [ { "ttft_ms": 2000, "gap_ms": null }, { "ttft_ms": 2000, "gap_ms": null }, { "ttft_ms": 2000, "gap_ms": null } ], "expected_stall_s": 20.0, "expected_prefill_s": 8.0 }
    ]
  }
}
